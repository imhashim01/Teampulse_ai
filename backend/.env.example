MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
JWT_SECRET=change-me
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Email (existing)
MAILTRAP_ENDPOINT=
MAILTRAP_TOKEN=
EMAIL_USER=
EMAIL_PASS=

# Cloudinary (existing)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI (Ji Sir Detector). Empty key -> rule-based fallback.
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
# Optional: AI_PROVIDER=gemini|openai|groq, AI_API_KEY=, AI_BASE_URL=

# WhatsApp Cloud API. Empty -> mock mode (deliveries saved as "Simulated").
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Set to an approved template (e.g. hello_world) to send templates instead of plain text
WHATSAPP_TEMPLATE_NAME=

# Protects POST /api/jobs/reminders (header x-cron-secret or Authorization: Bearer)
CRON_SECRET=change-me
