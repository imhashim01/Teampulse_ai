MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<db>
JWT_SECRET=change-me
PORT=5000
NODE_ENV=development
# Comma-separated list of allowed frontend origins
CLIENT_URL=http://localhost:5173

# Email (existing)
MAILTRAP_ENDPOINT=
MAILTRAP_TOKEN=
EMAIL_USER=
EMAIL_PASS=

# Cloudinary (existing)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# AI (Ji Sir Detector). Empty key -> rule-based fallback.
GEMINI_API_KEY=
AI_MODEL=gemini-2.5-flash
# Optional: AI_PROVIDER=gemini|openai|groq, AI_API_KEY=, AI_BASE_URL=

# Public frontend URL, used to build links in WhatsApp messages (e.g. task review links)
APP_BASE_URL=http://localhost:5173

# ---- Meta WhatsApp Cloud API (backend only, never put these in the frontend) ----
# false = dry run: deliveries are logged as "Simulated" and nothing is sent to Meta
WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_API_VERSION=v23.0
# Shown to users as the number to message (e.g. the test number while developing)
WHATSAPP_BUSINESS_DISPLAY_NUMBER=
# Any random string; paste the same value into the Meta webhook settings
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Meta app secret, used to verify webhook signatures (required in production)
WHATSAPP_APP_SECRET=

# Approved message templates (body parameter order is documented in WHATSAPP_SETUP.md)
WHATSAPP_VERIFICATION_TEMPLATE_NAME=
WHATSAPP_VERIFICATION_TEMPLATE_LANGUAGE=en
WHATSAPP_PROJECT_ADDED_TEMPLATE_NAME=
WHATSAPP_PROJECT_ADDED_TEMPLATE_LANGUAGE=en
WHATSAPP_TASK_SUBMITTED_TEMPLATE_NAME=
WHATSAPP_TASK_SUBMITTED_TEMPLATE_LANGUAGE=en
WHATSAPP_DEADLINE_TEMPLATE_NAME=
WHATSAPP_DEADLINE_TEMPLATE_LANGUAGE=en
WHATSAPP_OVERDUE_TEMPLATE_NAME=
WHATSAPP_OVERDUE_TEMPLATE_LANGUAGE=en
# Optional extra templates
WHATSAPP_TASK_ASSIGNED_TEMPLATE_NAME=
WHATSAPP_TASK_ASSIGNED_TEMPLATE_LANGUAGE=en
WHATSAPP_REVISION_TEMPLATE_NAME=
WHATSAPP_REVISION_TEMPLATE_LANGUAGE=en
WHATSAPP_NUDGE_TEMPLATE_NAME=
WHATSAPP_NUDGE_TEMPLATE_LANGUAGE=en
# true = send plain text when a template is missing. Only reaches users who messaged
# your number in the last 24 hours. Keep false in production.
WHATSAPP_FREEFORM_FALLBACK=false

# Verification codes
WHATSAPP_OTP_TTL_SECONDS=300
WHATSAPP_OTP_MAX_ATTEMPTS=5
WHATSAPP_OTP_RESEND_COOLDOWN_SECONDS=60
WHATSAPP_OTP_MAX_SENDS_PER_HOUR=5
# Key for hashing codes (defaults to JWT_SECRET)
WHATSAPP_OTP_SECRET=
# Local development only: print codes in the server console while WHATSAPP_ENABLED=false. Ignored in production.
WHATSAPP_DEV_LOG_OTP=false

# Sending
WHATSAPP_REQUEST_TIMEOUT_MS=5000
WHATSAPP_MAX_SEND_RETRIES=1
WHATSAPP_MAX_DELIVERY_ATTEMPTS=4

# Deadline reminders
WHATSAPP_REMINDERS_ENABLED=false
# Hours before the deadline, comma-separated
WHATSAPP_REMINDER_OFFSETS_HOURS=24,1
WHATSAPP_OVERDUE_REMINDER_ENABLED=true
# 0 = one overdue reminder; e.g. 24 = repeat daily, up to WHATSAPP_OVERDUE_MAX_REMINDERS
WHATSAPP_OVERDUE_REPEAT_HOURS=0
WHATSAPP_OVERDUE_MAX_REMINDERS=1
WHATSAPP_OVERDUE_NOTIFY_LEAD=true
WHATSAPP_REMINDER_TIMEZONE=Asia/Karachi
# Persistent servers only (local/VPS, not Vercel): also run reminders every N minutes in-process
REMINDER_INPROCESS_INTERVAL_MINUTES=0

# Protects POST /api/jobs/reminders (header x-cron-secret or Authorization: Bearer)
CRON_SECRET=change-me
